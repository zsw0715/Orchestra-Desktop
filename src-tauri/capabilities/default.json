{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "enables the default permissions",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "core:window:allow-start-dragging",
        "dialog:default",
        "fs:default",
        {
            "identifier": "fs:allow-read-dir",
            "allow": [
                { "path": "$HOME/**" }
            ]
        },
        {
            "identifier": "fs:allow-read-file",
            "allow": [
                { "path": "$HOME/**" }
            ]
        }
    ]
}